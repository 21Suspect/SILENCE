# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Browser QA state
/.playwright-cli/

# Reproducible Blender bake intermediates (the exported GLBs are tracked)
/scripts/assets/**/__pycache__/
/assets/world-v2/atlas_*.png

# Account-specific hosting
/.openai/*
!/.openai/hosting.json

# Generated by scripts/assets/world-v2/zfight.py: a report, rebuilt on demand.
/assets/world-v2/review/*.zfight.json

# Local visual review captures
/output/
